  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'For each strip, record:


    <b>Concentration of solution (%)</b>

    <b>Initial
    length (mm)</b>

    <b>Final length (mm)</b>

    <b>Change in length (mm)</b>
    = final length - initial length


    A <b>positive</b> change means the strip
    gained water (hypotonic solution).

    A <b>negative</b> change means the strip
    lost water (hypertonic solution).


    Plot <b>change in length</b> (y-axis)
    against <b>concentration</b> (x-axis). The concentration where the line crosses
    <b>zero</b> is the isotonic point.'
  m_isRightToLeft: 0
