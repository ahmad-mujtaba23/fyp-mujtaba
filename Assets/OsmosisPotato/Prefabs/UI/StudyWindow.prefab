--- !u!114 &7811016738739257500
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3865419196643206901}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 0
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: '<b>Osmosis</b> is the movement of water molecules from a region of <b>higher
    water concentration</b> (dilute solution) to a region of <b>lower water concentration</b>
    (concentrated solution) through a <b>partially permeable membrane</b>.


    The
    cell membrane of a potato cell lets small water molecules pass but holds back
    larger sugar molecules.


    <b>Hypotonic solution</b> (more dilute than cell
    sap): water moves <b>into</b> the cells. The cells swell and become <b>turgid</b>,
    and the potato strip gets <b>longer</b>.


    <b>Isotonic solution</b> (same
    concentration as cell sap): no net movement of water, so <b>no change</b> in
    length.


    <b>Hypertonic solution</b> (more concentrated than cell sap): water
    moves <b>out</b> of the cells. The cells become <b>flaccid / plasmolysed</b>,
    and the strip gets <b>shorter</b>.


    The concentration at which the change
    in length is zero is the <b>isotonic point</b>. It tells us the concentration
    of the potato cell sap.'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 0}
  m_sharedMaterial: {fileID: 0}
  m_fontSharedMaterials: []
  m_fontMaterial: {fileID: 0}
